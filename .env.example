# Google Gemini API Key for Server-Side AI Solution Architect
# Get an API key from Google AI Studio: https://aistudio.google.com/
# Leave empty to automatically use the deterministic mock architecture provider.
GEMINI_API_KEY=

# Optional Django Backend Integration for Lead Submissions
# If left empty, submitted leads are safely appended to leads.ndjson in development.
DJANGO_LEAD_ENDPOINT=
DJANGO_LEAD_TOKEN=

